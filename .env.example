# .env.example — copy to .env and fill in your keys

# ── Sarvam AI (Speech-to-Text) ──────────────────────────
# Sign up at: https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# ── LLM Provider (pick one) ─────────────────────────────
# Groq (recommended — fastest, free tier):  https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# OpenAI fallback (optional):  https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# ── Index paths ─────────────────────────────────────────
FAISS_INDEX_PATH=./data/faiss_index.bin
METADATA_PATH=./data/metadata.pkl

# ── Dataset settings ─────────────────────────────────────
# Number of training examples to ingest (use 0 for validation split only)
TRAIN_SAMPLE_SIZE=5000

# ── LLM settings ─────────────────────────────────────────
LLM_PROVIDER=groq                     # groq | openai
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512

# ── Guardrail thresholds ─────────────────────────────────
OFF_TOPIC_THRESHOLD=0.15              # cosine sim below this = off-topic (set to -1.0 to disable for testing)
GROUNDING_ROUGE_THRESHOLD=0.10       # min ROUGE-1 recall for output
CONFIDENCE_DISTANCE_THRESHOLD=1.60   # max L2 distance to accept retrieval
